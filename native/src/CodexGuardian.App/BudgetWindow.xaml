<Window x:Class="CodexGuardian.App.BudgetWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="{DynamicResource BudgetTitle}" Width="700" Height="700" MinWidth="560" MinHeight="460" WindowStartupLocation="CenterScreen" Background="#101722" Foreground="#E4F1FF" FontFamily="Segoe UI, Microsoft YaHei UI">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Resources/PlannerStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Grid Margin="24,20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,16">
   <TextBlock Text="{DynamicResource BudgetTitle}" FontSize="24" FontWeight="SemiBold"/>
   <TextBlock x:Name="BuildVersion" Foreground="#9BAFC6" FontSize="10"/>
   <TextBlock Text="{DynamicResource BudgetSubtitle}" Foreground="#9BAFC6" TextWrapping="Wrap" Margin="0,6,0,0"/>
   <TextBlock x:Name="WindowNote" Foreground="#80C3E2" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
   <TextBlock Text="{DynamicResource BudgetActivateNote}" Foreground="#9BAFC6" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
   <TextBlock x:Name="TopIssue" Foreground="#EBCB8B" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
   <Button Content="{DynamicResource BudgetReload}" Click="ReloadContext" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="10,5"/>
  </StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="0,0,6,0">
    <ListBox x:Name="BudgetMode" Visibility="Collapsed" Background="Transparent" Foreground="#E4F1FF" BorderThickness="0" SelectedIndex="0" SelectionChanged="ModeChanged" Margin="0,0,0,12" Padding="10">
     <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBoxItem Content="{DynamicResource ModeWeekly}" Padding="14,8"/><ListBoxItem Content="{DynamicResource ModeEvent}" Padding="14,8"/></ListBox>
    <Border x:Name="EventPanel" Visibility="Collapsed" Background="#1B283A" CornerRadius="12" Padding="14" Margin="0,0,0,14"><StackPanel>
     <TextBlock Text="{DynamicResource EventHelp}" TextWrapping="Wrap" Foreground="#A9BED6"/>
     <TextBlock x:Name="EventTimezone" TextWrapping="Wrap" Foreground="#80C3E2" Margin="0,6,0,0"/>
     <ComboBox x:Name="EventKind" SelectedIndex="0" SelectionChanged="EventChanged" Margin="0,10,0,8"><ComboBoxItem Content="{DynamicResource EventAnnouncement}"/><ComboBoxItem Content="{DynamicResource EventCard}"/></ComboBox>
     <TextBlock Text="{DynamicResource EventTime}"/>
     <WrapPanel Margin="0,6,0,12">
      <DatePicker x:Name="EventAtDate" Width="160" SelectedDateChanged="EventDateChanged" Margin="0,0,8,4" AutomationProperties.Name="{DynamicResource EventTime}"/>
      <ComboBox x:Name="EventAtHour" Width="60" SelectionChanged="EventChanged" Margin="0,0,4,4" ToolTip="{DynamicResource TimeHour}" AutomationProperties.Name="{DynamicResource TimeHour}"/>
      <TextBlock Text=":" VerticalAlignment="Center" Margin="0,0,4,4"/>
      <ComboBox x:Name="EventAtMinute" Width="60" SelectionChanged="EventChanged" Margin="0,0,10,4" ToolTip="{DynamicResource TimeMinute}" AutomationProperties.Name="{DynamicResource TimeMinute}"/>
      <Button Content="{DynamicResource DateToday}" Tag="EventAt:0" Click="ChooseDate" Padding="8,5" Margin="0,0,6,4"/>
      <Button Content="{DynamicResource DateTomorrow}" Tag="EventAt:1" Click="ChooseDate" Padding="8,5" Margin="0,0,0,4"/>
     </WrapPanel>
     <TextBlock Text="{DynamicResource EventExpiry}"/>
     <WrapPanel Margin="0,6,0,12">
      <DatePicker x:Name="EventExpiresDate" Width="160" SelectedDateChanged="EventDateChanged" Margin="0,0,8,4" AutomationProperties.Name="{DynamicResource EventExpiry}"/>
      <ComboBox x:Name="EventExpiresHour" Width="60" SelectionChanged="EventChanged" Margin="0,0,4,4" ToolTip="{DynamicResource TimeHour}" AutomationProperties.Name="{DynamicResource TimeHour}"/>
      <TextBlock Text=":" VerticalAlignment="Center" Margin="0,0,4,4"/>
      <ComboBox x:Name="EventExpiresMinute" Width="60" SelectionChanged="EventChanged" Margin="0,0,10,4" ToolTip="{DynamicResource TimeMinute}" AutomationProperties.Name="{DynamicResource TimeMinute}"/>
      <Button Content="{DynamicResource DateToday}" Tag="EventExpires:0" Click="ChooseDate" Padding="8,5" Margin="0,0,6,4"/>
      <Button Content="{DynamicResource DateTomorrow}" Tag="EventExpires:1" Click="ChooseDate" Padding="8,5" Margin="0,0,0,4"/>
     </WrapPanel>
    </StackPanel></Border>
    <UniformGrid Columns="3" Margin="0,0,0,18">
     <Border Background="#1B283A" CornerRadius="12" Padding="14" Margin="0,0,8,0"><StackPanel>
      <TextBlock Text="{DynamicResource BudgetRemainingLabel}" Foreground="#A9BED6" FontSize="11" TextWrapping="Wrap"/>
      <TextBlock x:Name="WeeklyRemaining" Text="—" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,0"/>
     </StackPanel></Border>
     <Border Background="#18343B" CornerRadius="12" Padding="14" Margin="0,0,8,0"><StackPanel>
      <TextBlock Text="{DynamicResource BudgetAvailableLabel}" Foreground="#9BCDCB" FontSize="11" TextWrapping="Wrap"/>
      <TextBlock x:Name="AvailableBudget" Text="—" FontSize="28" FontWeight="SemiBold" Foreground="#A4E4DA" Margin="0,8,0,0"/>
     </StackPanel></Border>
     <Border Background="#1B283A" CornerRadius="12" Padding="14"><StackPanel>
      <TextBlock Text="{DynamicResource BudgetReserveShort}" Foreground="#A9BED6" FontSize="11" TextWrapping="Wrap"/>
      <TextBox x:Name="Reserve" Text="10" MaxLength="3" Margin="0,8,0,0" TextChanged="Changed" ToolTip="{DynamicResource BudgetReserve}" AutomationProperties.Name="{DynamicResource BudgetReserve}"/>
     </StackPanel></Border>
    </UniformGrid>
    <Border Background="#18343B" CornerRadius="12" Padding="14" Margin="0,0,0,16"><StackPanel>
     <TextBlock x:Name="TodayAdvice" Foreground="#A4E4DA" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
     <TextBlock Text="{DynamicResource BudgetTodayBasis}" Foreground="#A9BED6" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
    </StackPanel></Border>
    <TextBlock Text="{DynamicResource BudgetScheduleTitle}" FontSize="16" FontWeight="SemiBold"/>
    <TextBlock Text="{DynamicResource BudgetScheduleHint}" Foreground="#9BAFC6" TextWrapping="Wrap" FontSize="11" Margin="0,5,0,10"/>
    <WrapPanel Margin="0,0,0,12">
     <Button Content="{DynamicResource BudgetEven}" Click="ApplyPreset" Tag="even" FontSize="11" Margin="0,0,8,4"/>
     <Button Content="{DynamicResource BudgetWeekdays}" Click="ApplyPreset" Tag="weekdays" FontSize="11" Margin="0,0,8,4"/>
     <Button Content="{DynamicResource BudgetToday}" Click="ApplyPreset" Tag="today" FontSize="11" Margin="0,0,0,4"/>
    </WrapPanel>
    <ItemsControl x:Name="PlanGrid"><ItemsControl.ItemTemplate><DataTemplate>
     <Border Background="#1B283A" CornerRadius="12" Padding="14" Margin="0,0,0,8"><StackPanel>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock Text="{Binding DateLabel}" FontWeight="SemiBold" FontSize="14"/>
       <StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock Text="{DynamicResource PlanAllocation}" Foreground="#9BAFC6" Margin="0,0,10,0"/><TextBlock Text="{Binding Allocation}" Foreground="#A4E4DA" FontWeight="SemiBold"/></StackPanel>
      </Grid>
      <WrapPanel Margin="0,10,0,0">
       <Button Content="{DynamicResource DayRest}" Tag="0" Click="ChooseEffort" Margin="0,0,6,4"/>
       <Button Content="{DynamicResource DayLight}" Tag="0.5" Click="ChooseEffort" Margin="0,0,6,4"/>
       <Button Content="{DynamicResource DayNormal}" Tag="1" Click="ChooseEffort" Margin="0,0,6,4"/>
       <Button Content="{DynamicResource DayFocus}" Tag="2" Click="ChooseEffort" Margin="0,0,6,4"/>
       <TextBlock Text="{Binding EffortLabel}" Foreground="#A4E4DA" VerticalAlignment="Center" Margin="8,0,0,0"/>
      </WrapPanel>
      <Expander Header="{DynamicResource DayAdvanced}" Foreground="#9BAFC6" Margin="0,6,0,0"><StackPanel Orientation="Horizontal" Margin="0,8,0,0">
       <TextBlock Text="{DynamicResource PlanMinimum}" VerticalAlignment="Center" Margin="0,0,12,0"/>
       <TextBox Text="{Binding Minimum, UpdateSourceTrigger=PropertyChanged}" TextChanged="Changed" Width="70"/>
      </StackPanel></Expander>
     </StackPanel></Border>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <Border Background="#1C2C3E" CornerRadius="12" Padding="14" Margin="0,14,0,0"><StackPanel>
     <TextBlock x:Name="Result" TextWrapping="Wrap" FontWeight="SemiBold"/>
     <TextBlock x:Name="RolloverNotice" Text="{DynamicResource BudgetRollover}" TextWrapping="Wrap" Foreground="#EBCB8B" FontSize="11" Margin="0,8,0,0" Visibility="Collapsed"/>
     <TextBlock x:Name="Forecast" TextWrapping="Wrap" Foreground="#B6C9DE" FontSize="12" Margin="0,8,0,0"/>
     <TextBlock x:Name="IdentityNotice" Text="{DynamicResource PlanNoIdentity}" TextWrapping="Wrap" Foreground="#EBCB8B" FontSize="11" Margin="0,8,0,0" Visibility="Collapsed"/>
    </StackPanel></Border>
    <Expander Header="{DynamicResource BudgetExplanation}" Foreground="#A9BED6" Margin="0,12,0,12"><TextBlock Text="{DynamicResource PlanNote}" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"/></Expander>
   </StackPanel>
  </ScrollViewer>
  <Grid Grid.Row="2" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="{DynamicResource BudgetLocalNote}" TextWrapping="Wrap" Foreground="#8FA7C1" FontSize="11" VerticalAlignment="Center" Margin="0,0,16,0"/>
   <Button Grid.Column="1" x:Name="SavePlanButton" Content="{DynamicResource BudgetSave}" Click="Save" Background="#2D6073" BorderBrush="#57899B" Padding="22,10" MinWidth="100"/>
  </Grid>
 </Grid>
</Window>
